<configuration>
    <input>
        <net-file value="osm.net.xml"/>
        <route-files value="routes.rou.xml"/>
    </input>

    <processing>
        <max-num-vehicles value="400"/>
        <extrapolate-departpos value="true"/>
    </processing>
    
    <time>
        <step-length value="1.0"/>
    </time>

    <output>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
    </output>
</configuration>
